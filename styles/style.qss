QMainWindow {
    background-color: #2b2b2b;
}

#micButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #e74c3c, stop:1 #c0392b);
    border: none;
    border-radius: 70px;
    padding: 0;
}
#micButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff5e50, stop:1 #e74c3c);
}
#micButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #c0392b, stop:1 #a93226);
}

#micButtonActive {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2ecc71, stop:1 #27ae60);
    border: 2px solid #2ecc71;
    border-radius: 70px;
    padding: 0;
}
#micButtonActive:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3dd17a, stop:1 #2ecc71);
}
#micButtonActive:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #27ae60, stop:1 #219a52);
}

#settingsButton {
    background-color: #555555;
    border: 2px solid #666666;
    border-radius: 25px;
}
#settingsButton:hover {
    background-color: #666666;
    border-color: #888888;
}
#settingsButton:pressed {
    background-color: #444444;
}

#calibrateButton {
    background-color: #555555;
    color: #ffffff;
    border: 2px solid #666666;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 20px;
}
#calibrateButton:hover {
    background-color: #666666;
    border-color: #888888;
}
#calibrateButton:pressed {
    background-color: #444444;
}
#calibrateButton:disabled {
    background-color: #444444;
    color: #888888;
    border-color: #555555;
}

QToolTip {
    background-color: #3a3a3a;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px;
    font-size: 13px;
}

QTextEdit#chatDisplay {
    background: #1a1a1a; 
    border: 1px solid #404040; 
    border-radius: 8px;
    padding: 10px; 
    color: #e6e6e6; 
    font-size: 16px;
}

QLineEdit#chatInput {
    background: #252525; 
    border: 1px solid #505050; 
    border-radius: 6px;
    padding: 10px; 
    color: #fff; 
    font-size: 14px;
}

QPushButton#sendButton {
    border-radius: 21px; 
    background: #0066cc; 
    color: white; 
    font-weight: bold;
}
QPushButton#sendButton:hover { background: #0055aa; }
QPushButton#sendButton:pressed { background: #004488; }
